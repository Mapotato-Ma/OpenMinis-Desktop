{
  "name": "openminis-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Web frontend for the OpenMinis Python port (mirrors the Android Compose UI).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:ws": "esbuild scripts/ws-reconnect.check.ts --bundle --platform=node --format=esm --outfile=scripts/.ws-check.mjs --log-level=warning && node scripts/.ws-check.mjs",
    "check:settings": "node --test scripts/settings-model.check.mjs",
    "check": "npm run check:ws && npm run check:settings"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
